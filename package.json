    "db:migrate:dev": "prisma migrate dev",
    "db:seed:development": "npx tsx prisma/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "financial",
